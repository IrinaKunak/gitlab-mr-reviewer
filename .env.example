# Primary GitLab Instance
GITLAB_URL=https://lab.smysl.pro
GITLAB_TOKEN=your_gitlab_token_here
XGITLABTOKEN=your_webhook_secret_here

# Second GitLab Instance (optional)
GITLAB_URL_2=https://lab.catzwolf.ru
GITLAB_TOKEN_2=your_second_gitlab_token_here
XGITLABTOKEN_2=your_second_webhook_secret_here

# Additional instances can be added with _3, _4, etc. suffixes (up to _10)

# === AI Provider ===
# anthropic = Claude via Cloudflare AI Gateway (recommended); gemini = legacy wrapper
# (rollback only — the v2 image ships no Gemini CLI, full rollback = deploy master)
AI_PROVIDER=anthropic
# Cloudflare AI Gateway Anthropic provider endpoint (native route, NOT /compat)
ANTHROPIC_API_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
# Real Anthropic key (sent as x-api-key through the gateway)
ANTHROPIC_API_KEY=sk-ant-your_key_here
# cfut_... gateway auth token (sent as cf-aig-authorization header; needed when the
# gateway is authenticated, or alone for Unified Billing without ANTHROPIC_API_KEY —
# Unified Billing requires wholesale credits topped up in the CF dashboard)
ANTHROPIC_API_KEY_GATEWAY=cfut_your_gateway_token_here
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_MAIN_MODEL=claude-sonnet-5
ANTHROPIC_SMART_MODEL=claude-opus-5
# OpenRouter fallback (Anthropic-compatible /api/v1/messages, models array failover)
OPENROUTER_API_TOKEN=sk-or-your_token_here
#OPENROUTER_FALLBACK_FAST=anthropic/claude-haiku-4.5,google/gemini-3.5-flash-lite,deepseek/deepseek-v4-flash
#OPENROUTER_FALLBACK_MAIN=anthropic/claude-sonnet-5,google/gemini-3.6-flash,deepseek/deepseek-v4-pro
#OPENROUTER_FALLBACK_SMART=anthropic/claude-opus-5,openai/gpt-5.6-terra,moonshotai/kimi-k3

# === Feature flags (rollout phases — see plans/2026-06-11-v2-architecture.md) ===
# All ON in production since 2026-07-23; all off = v1-parity single-pass review.
PIPELINE_V2=on        # tiered pipeline: triage (fast) -> review (main) -> translate
INVESTIGATOR=on       # Opus agentic investigation for complex MRs (needs repo cache disk)
BRIDGE=on             # ask AIManager questions in the Review Bridge Telegram group
TESTER_REPORT=on      # produce + deliver tester reports (.md to MR + Telegram)
# The review stage gets read-only repo tools (grep/read/tree at the MR head) and
# VERIFIES cross-file concerns itself instead of asking the author to "confirm"
# them. Costs a few cached agent turns per review (~+$0.05 typical). Non-trivial
# MRs clone into the repo cache — budget disk accordingly (avoid pairing with
# REPO_CACHE_EPHEMERAL=true, which would re-clone on every review).
REVIEW_REPO_TOOLS=on
#REVIEW_MAX_TOOL_CALLS=8      # verification budget per review (and per dialogue reply)
# Answer developer replies in MR discussion threads (reply to a bot comment or
# @mention the bot). Needs note_events on the project webhooks — re-run
# `python add_webhooks_to_all_projects.py` once after enabling.
MR_DIALOGUE=on
#DIALOGUE_MAX_REPLIES_PER_MR=20   # per MR per day; the bot never argues past it

# === Review Bridge ===
# The bot token is long-polled EXCLUSIVELY by this service; the bot must be in the
# bridge group with privacy mode disabled, alongside AIManager.
REVIEW_BRIDGE_CHAT_ID=
#BRIDGE_QUESTION_TIMEOUT=240   # AIManager answers in 50-180s; 90 dropped late answers
#BRIDGE_MAX_QUESTIONS_PER_MR=10
#BRIDGE_RATE_PER_HOUR=25
#BRIDGE_ANSWER_BOT_ID=        # restrict accepted answers to AIManager's bot id (optional)

# === AI behavior ===
#AI_CACHE_TTL=3600
#AI_TIMEOUT=300               # per-attempt; timed-out calls still bill server-side
#AI_AGENT_TIMEOUT=600
#AI_RATE_LIMIT=2
#AI_MAX_INPUT_TOKENS=300000   # tier models have 1M context; 150k refused real MRs
#AI_WORKERS=2
AI_DEBUG=false                # request/response dumps to logs/ai-debug.log (rotating)

# === Webhook dedupe ===
#DEDUPE_TTL=600               # exact same MR+SHA suppressed for this long
#DEDUPE_BURST_SECONDS=30      # events for the same MR within this window collapse
# MRs with "[no-review]" in the title or a "no-review" label are never reviewed.

# === Repo clone cache (investigator) ===
#REPO_CACHE_DIR=/app/repos
# Disk budget for cached clones (LRU eviction above it). Leave headroom on the
# volume for temporary worktrees (~1 working copy per worker). 20 GB volume -> 12.
REPO_CACHE_MAX_GB=25
# true = clone -> investigate -> remove every time (near-zero residency, but every
# complex MR re-clones the whole project); false = keep clones, fetch deltas (faster)
#REPO_CACHE_EPHEMERAL=false
#INVESTIGATOR_MAX_ITERATIONS=30

# === Usage stats ===
# Per-review entries in logs/usage.jsonl; totals at GET /stats; Telegram footer.
# Auth for /stats, /dashboard and /admin/*:
#  - STATS_USER + STATS_PASSWORD -> HTTP Basic (browser login prompt) — recommended
#  - STATS_TOKEN -> Bearer header or ?token= (for scripts/curl)
# Neither set = direct local access only (proxied requests are refused).
#STATS_USER=
#STATS_PASSWORD=
#STATS_TOKEN=
# Runtime per-tier model overrides are set from the dashboard (persisted in
# cache/model_overrides.json); defaults come from ANTHROPIC_*_MODEL above.
# The dashboard lists the full OpenRouter catalog (any id with a "/" routes via
# OpenRouter, priced from the live catalog) so you can A/B cheaper models vs Opus.
# Override $/MTok prices, e.g. when claude-sonnet-5 intro pricing ends 2026-08-31:
#MODEL_PRICES=claude-sonnet-5=3/15
# Where tester reports go besides the bridge chat (default: all TELEGRAM_CHAT_ID*)
#TESTER_REPORT_CHAT_IDS=

# Telegram Configuration (optional)
TELEGRAM=off  # Set to "on" to enable
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# TELEGRAM_CHAT_ID_1 .. TELEGRAM_CHAT_ID_10 for additional channels

# Proxy Configuration (optional — remove entirely if the host has direct internet!)
#HTTP_PROXY=http://127.0.0.1:8181
#SOCKS_PROXY=127.0.0.1:8180

# Review Settings
REVIEW_LANGUAGE=ru  # Options: en, ru (prompts are English; final output translated)
REVIEW_FOR_CONFLICT=false  # Set to "true" to review MRs with conflicts

# Debug Configuration
DEBUG=false

# === Legacy (AI_PROVIDER=gemini rollback path only) ===
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_DEBUG=false

# Custom review checklist override (English; used as the review system prompt)
#GEMINI_PROMPT="Review this merge request and provide: ..."
