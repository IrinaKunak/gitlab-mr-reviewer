# Primary GitLab Instance
GITLAB_URL=https://lab.smysl.pro
GITLAB_TOKEN=your_gitlab_token_here
XGITLABTOKEN=your_webhook_secret_here

# Second GitLab Instance (optional)
GITLAB_URL_2=https://lab.catzwolf.ru
GITLAB_TOKEN_2=your_second_gitlab_token_here
XGITLABTOKEN_2=your_second_webhook_secret_here

# Additional instances can be added with _3, _4, etc. suffixes (up to _10)

# Telegram Configuration (optional)
TELEGRAM=off  # Set to "on" to enable
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Proxy Configuration (optional)
HTTP_PROXY=http://127.0.0.1:8181
SOCKS_PROXY=127.0.0.1:8180

# Review Settings
REVIEW_LANGUAGE=en  # Options: en, ru
REVIEW_FOR_CONFLICT=false  # Set to "true" to review MRs with conflicts

# Gemini Configuration
GEMINI_PROMPT="Review this merge request and provide:
1. Code quality assessment
2. Potential bugs or issues
3. Security concerns
4. Performance considerations
5. Best practices violations
6. Suggestions for improvement

Be concise but thorough. Focus on actionable feedback."

# Russian translation prompt
GEMINI_PROMPT_RU="Проанализируйте этот запрос на слияние и предоставьте:
1. Оценка качества кода
2. Потенциальные баги или проблемы
3. Проблемы безопасности
4. Вопросы производительности
5. Нарушения лучших практик
6. Предложения по улучшению

Будьте лаконичными, но основательными. Сосредоточьтесь на практических рекомендациях."