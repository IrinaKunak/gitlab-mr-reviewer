# Primary GitLab Instance
GITLAB_URL=https://lab.smysl.pro
GITLAB_TOKEN=your_gitlab_token_here
XGITLABTOKEN=your_webhook_secret_here

# Second GitLab Instance (optional)
GITLAB_URL_2=https://lab.catzwolf.ru
GITLAB_TOKEN_2=your_second_gitlab_token_here
XGITLABTOKEN_2=your_second_webhook_secret_here

# Additional instances can be added with _3, _4, etc. suffixes (up to _10)

# === AI Provider ===
# anthropic = Claude via Cloudflare AI Gateway (recommended); gemini = legacy wrapper
AI_PROVIDER=anthropic
# Cloudflare AI Gateway Anthropic provider endpoint
ANTHROPIC_API_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
# cfut_... gateway token (sent as cf-aig-authorization header) OR a real Anthropic key
ANTHROPIC_API_KEY_GATEWAY=cfut_your_gateway_token_here
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_MAIN_MODEL=claude-sonnet-4-6
ANTHROPIC_SMART_MODEL=claude-opus-4-8
# OpenRouter fallback (Anthropic-compatible /api/v1/messages, models array failover)
OPENROUTER_API_TOKEN=sk-or-your_token_here
#OPENROUTER_FALLBACK_FAST=anthropic/claude-haiku-4.5,google/gemini-3.1-flash-lite,deepseek/deepseek-v4-flash
#OPENROUTER_FALLBACK_MAIN=anthropic/claude-sonnet-4.6,google/gemini-3.5-flash,deepseek/deepseek-v4-pro
#OPENROUTER_FALLBACK_SMART=anthropic/claude-opus-4.8,openai/gpt-5.5,google/gemini-3.1-pro-preview

# === Feature flags (rollout phases — see plans/2026-06-11-v2-architecture.md) ===
PIPELINE_V2=off       # tiered pipeline: triage (fast) -> review (main) -> translate
INVESTIGATOR=off      # Opus agentic investigation for complex MRs (needs repo cache disk)
BRIDGE=off            # ask AIManager questions in the Review Bridge Telegram group
TESTER_REPORT=off     # produce + deliver tester reports (.md to MR + bridge chat)

# === Review Bridge ===
REVIEW_BRIDGE_CHAT_ID=
#BRIDGE_QUESTION_TIMEOUT=90
#BRIDGE_MAX_QUESTIONS_PER_MR=10
#BRIDGE_RATE_PER_HOUR=25
#BRIDGE_ANSWER_BOT_ID=        # restrict accepted answers to AIManager's bot id (optional)

# === AI behavior ===
#AI_CACHE_TTL=3600
#AI_TIMEOUT=120
#AI_AGENT_TIMEOUT=600
#AI_RATE_LIMIT=2
#AI_MAX_INPUT_TOKENS=150000
#AI_WORKERS=2
AI_DEBUG=false

# === Repo clone cache (investigator) ===
#REPO_CACHE_DIR=/app/repos
#REPO_CACHE_MAX_GB=30
#INVESTIGATOR_MAX_ITERATIONS=30

# Telegram Configuration (optional)
TELEGRAM=off  # Set to "on" to enable
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Proxy Configuration (optional)
HTTP_PROXY=http://127.0.0.1:8181
SOCKS_PROXY=127.0.0.1:8180

# Review Settings
REVIEW_LANGUAGE=en  # Options: en, ru
REVIEW_FOR_CONFLICT=false  # Set to "true" to review MRs with conflicts

# Debug Configuration
DEBUG=false

# === Legacy (AI_PROVIDER=gemini rollback path only) ===
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_DEBUG=false

# Custom review checklist override (English; used as the review system prompt)
#GEMINI_PROMPT="Review this merge request and provide: ..."
